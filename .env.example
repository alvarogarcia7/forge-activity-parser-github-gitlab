# Copy to .env (`make .env`), which is git-ignored and mounted read-only.
# Read by app/collect.sh as KEY=VALUE lines (not executed as a shell script).

# Personal access tokens for private repos. Public repos need none.
# GitHub: fine-grained token with "Contents: read" on the repos you list.
GITHUB_TOKEN=
# GitLab: token with read_repository scope.
GITLAB_TOKEN=

# Optional: also write data/mine.jsonl with commits whose Author matches (case-insensitive).
# Author looks like "Name <email>", so a name or email fragment works.
AUTHOR_REGEX=
