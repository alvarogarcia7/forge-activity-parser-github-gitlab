# .env.example: template for .env
#
# Setup:   make .env   (copies this file to .env with mode 400)
# Edit:    chmod u+w .env && $EDITOR .env && chmod 400 .env
#
# .env is git-ignored and reaches the collector only through the read-only repo
# mount (/app/.env). app/collect.sh parses it; it is never executed as a script.
#
# Format rules:
#   - One KEY=VALUE per line, no spaces around "=".
#   - Comments go on their own line, ABOVE the value. Never put "# ..." after a
#     value: it would become part of the value (collect.sh refuses such lines).
#   - Quotes are optional; use them only if the value has leading/trailing spaces.
#   - Leave a value empty to disable it.
#   - A variable already set in the environment takes precedence over this file.


# --- Secrets -----------------------------------------------------------------

# GitHub personal access token, only needed for private repos.
# Fine-grained token: Repository access = the repos in config/repos.txt,
# Permissions = Contents: Read-only. Classic token: "repo" scope.
# Example: GITHUB_TOKEN=github_pat_11AAAA...
GITHUB_TOKEN=

# GitLab personal access token, only needed for private repos on gitlab.com.
# Scope: read_repository.
# Example: GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_TOKEN=


# --- Options -----------------------------------------------------------------

# Regex (case-insensitive) matched against each commit's Author ("Name <email>").
# When set, every run also rebuilds data/mine.jsonl with only the matching commits.
# Example: AUTHOR_REGEX=alvaro|alvarogarcia7
AUTHOR_REGEX=


# --- Build / compose (read by docker compose and make, not by collect.sh) ----

# uid/gid of the non-root "app" user in the collector image. Defaults to your
# host uid/gid (so ./data stays writable); never 0. Only set to override.
# Example: HOST_UID=1000
HOST_UID=
HOST_GID=
